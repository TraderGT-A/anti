# คัดลอกเป็น scripts/news/.env แล้วใส่ค่าเอง (ไฟล์ .env ไม่เข้า git)
# Supabase ของ rsdash: Project Settings → API (ใช้ service_role key เพราะต้องเขียนตาราง stock_notes)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# SEC บังคับ User-Agent ที่มีชื่อ + ช่องทางติดต่อ เช่น "ชื่อคุณ you@example.com" — เว้นว่าง = ข้าม SEC
NEWS_SEC_UA=
